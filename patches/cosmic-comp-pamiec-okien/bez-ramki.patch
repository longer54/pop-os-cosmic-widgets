 impl CosmicMapped {
+    /// Okna bez zoltej ramki aktywnego okna (active hint) - łatka "bez-ramki".
+    /// Lista app_id w ~/.config/cosmic-bez-ramki (po jednym w linii), domyslnie pusta.
+    pub fn bez_ramki(&self) -> bool {
+        static LISTA: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+        let lista = LISTA.get_or_init(|| {
+            std::env::var_os("HOME")
+                .and_then(|h| std::fs::read_to_string(std::path::Path::new(&h).join(".config/cosmic-bez-ramki")).ok())
+                .map(|t| t.lines().map(|l| l.trim().to_string()).filter(|l| !l.is_empty() && !l.starts_with('#')).collect())
+                .unwrap_or_default()
+        });
+        let app_id = self.active_window().app_id();
+        lista.iter().any(|a| *a == app_id)
+    }
+
