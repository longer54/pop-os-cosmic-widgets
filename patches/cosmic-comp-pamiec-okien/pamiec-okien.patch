@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//
+// Pamięć geometrii okien pomiędzy uruchomieniami aplikacji (dodatek lokalny).
+//
+// Upstreamowy cosmic-comp pamięta rozmiar/pozycję tylko przez czas życia okna
+// (CosmicMapped::last_geometry). Po zamknięciu aplikacji wiedza ginie, a nowe
+// okno pływające jest przycinane do 2/3 ekranu (floating::map_internal).
+// Ten moduł trzyma ostatnią geometrię pod kluczem app_id w
+// ~/.local/state/cosmic-comp/window-geometry.ron i pozwala ją odtworzyć.
+
+use std::{
+    collections::HashMap,
+    fs,
+    path::PathBuf,
+    sync::{Mutex, OnceLock},
+};
+
+use serde::{Deserialize, Serialize};
+use tracing::warn;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SavedGeometry {
+    pub x: i32,
+    pub y: i32,
+    pub w: i32,
+    pub h: i32,
+}
+
+struct Store {
+    path: Option<PathBuf>,
+    entries: HashMap<String, SavedGeometry>,
+}
+
+static STORE: OnceLock<Mutex<Store>> = OnceLock::new();
+
+fn store() -> &'static Mutex<Store> {
+    STORE.get_or_init(|| {
+        let path = xdg::BaseDirectories::new()
+            .place_state_file("cosmic-comp/window-geometry.ron")
+            .ok();
+        let entries = path
+            .as_deref()
+            .filter(|path| path.exists())
+            .and_then(|path| {
+                fs::read_to_string(path)
+                    .map_err(|err| warn!(?err, "Failed to read window-geometry.ron"))
+                    .ok()
+            })
+            .and_then(|raw| {
+                ron::from_str::<HashMap<String, SavedGeometry>>(&raw)
+                    .map_err(|err| warn!(?err, "Failed to parse window-geometry.ron"))
+                    .ok()
+            })
+            .unwrap_or_default();
+
+        Mutex::new(Store { path, entries })
+    })
+}
+
+/// Ostatnio zapamiętana geometria okna danej aplikacji.
+pub fn get(app_id: &str) -> Option<SavedGeometry> {
+    if app_id.is_empty() {
+        return None;
+    }
+    store().lock().unwrap().entries.get(app_id).copied()
+}
+
+/// Zapamiętaj geometrię okna. Zapis na dysk tylko gdy coś się faktycznie zmieniło.
+pub fn set(app_id: &str, geometry: SavedGeometry) {
+    if app_id.is_empty() || geometry.w <= 0 || geometry.h <= 0 {
+        return;
+    }
+
+    let mut store = store().lock().unwrap();
+    if store.entries.get(app_id) == Some(&geometry) {
+        return;
+    }
+    store.entries.insert(app_id.to_string(), geometry);
+
+    let Some(path) = store.path.clone() else {
+        return;
+    };
+    match ron::ser::to_string_pretty(&store.entries, ron::ser::PrettyConfig::default()) {
+        Ok(raw) => {
+            if let Err(err) = fs::write(&path, raw) {
+                warn!(?err, "Failed to write window-geometry.ron");
+            }
+        }
+        Err(err) => warn!(?err, "Failed to serialize window-geometry.ron"),
+    }
+}
