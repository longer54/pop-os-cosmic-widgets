new file mode 100644
index 0000000..43c7d80
--- /dev/null
+++ b/cosmic-applet-time/src/obsidian.rs
@@ -0,0 +1,129 @@
+// Łatka: kalendarzyk apletu zegara = kalendarz dziennych notatek Obsidiana.
+//
+// Ustawienia czytane z tego samego pliku co widget kalendarza
+// (~/.config/cosmic-calendar-widget/config.toml), żeby oba zachowywały się
+// identycznie: ten sam vault, folder, szablon, kropki i przełącznik
+// "otwieraj w Obsidianie / jako plik .md".
+
+use std::{collections::HashMap, path::PathBuf};
+
+use jiff::civil::Date;
+
+pub struct Vault {
+    path: PathBuf,
+    name: String,
+    daily_folder: String,
+    template: String,
+    words_per_dot: u32,
+    max_dots: u32,
+    open_in_obsidian: bool,
+}
+
+impl Vault {
+    pub fn load() -> Self {
+        let home = std::env::var("HOME").unwrap_or_default();
+        let mut v = Vault {
+            path: PathBuf::from(&home).join("Obsidian"),
+            name: "MyVault".into(),
+            daily_folder: "Kalendarz".into(),
+            template: "Kalendarz/Szablony/Szablon Dnia".into(),
+            words_per_dot: 250,
+            max_dots: 5,
+            open_in_obsidian: true,
+        };
+        let cfg = PathBuf::from(&home).join(".config/cosmic-calendar-widget/config.toml");
+        let Ok(text) = std::fs::read_to_string(cfg) else {
+            return v;
+        };
+        // Płaski TOML klucz = wartość — pełny parser nie jest tu potrzebny.
+        for line in text.lines() {
+            let Some((key, val)) = line.split_once('=') else {
+                continue;
+            };
+            let val = val.trim().trim_matches('"');
+            match key.trim() {
+                "vault_path" => v.path = PathBuf::from(val),
+                "vault_name" => v.name = val.into(),
+                "daily_notes_folder" => v.daily_folder = val.into(),
+                "daily_note_template" => v.template = val.into(),
+                "words_per_dot" => v.words_per_dot = val.parse().unwrap_or(v.words_per_dot),
+                "max_dots" => v.max_dots = val.parse().unwrap_or(v.max_dots),
+                "open_in_obsidian" => v.open_in_obsidian = val == "true",
+                _ => {}
+            }
+        }
+        v
+    }
+
+    fn note_path(&self, date: Date) -> PathBuf {
+        self.path.join(&self.daily_folder).join(format!("{date}.md"))
+    }
+
+    /// 1:1 `getWordLengthAsDots` z wtyczki Calendar: brak notatki = 0,
+    /// istniejąca (nawet pusta) = co najmniej 1.
+    fn dots_for(&self, date: Date) -> u8 {
+        let Ok(text) = std::fs::read_to_string(self.note_path(date)) else {
+            return 0;
+        };
+        if self.words_per_dot == 0 {
+            return 1;
+        }
+        let words = text.split_whitespace().count() as u32;
+        (words / self.words_per_dot).clamp(1, self.max_dots.max(1)) as u8
+    }
+
+    pub fn scan(&self, first: Date, days: i64) -> HashMap<Date, u8> {
+        (0..days)
+            .filter_map(|i| first.checked_add(jiff::Span::new().days(i)).ok())
+            .map(|d| (d, self.dots_for(d)))
+            .filter(|(_, n)| *n > 0)
+            .collect()
+    }
+
+    /// Tworzy notatkę dnia z szablonu (jeśli jej nie ma) i ją otwiera.
+    pub fn open_day(&self, date: Date) {
+        let path = self.note_path(date);
+        if !path.exists() {
+            let d = date.to_string();
+            let content = if self.template.trim().is_empty() {
+                String::new()
+            } else {
+                std::fs::read_to_string(self.path.join(format!("{}.md", self.template)))
+                    .unwrap_or_default()
+                    .replace("{{date}}", &d)
+                    .replace("{{title}}", &d)
+            };
+            if let Some(parent) = path.parent() {
+                let _ = std::fs::create_dir_all(parent);
+            }
+            if let Err(err) = std::fs::write(&path, content) {
+                tracing::error!(?err, "nie mogę utworzyć notatki dnia");
+            }
+        }
+        let target = if self.open_in_obsidian {
+            format!(
+                "obsidian://open?vault={}&file={}",
+                percent_encode(&self.name),
+                percent_encode(&format!("{}/{date}", self.daily_folder))
+            )
+        } else {
+            path.to_string_lossy().into_owned()
+        };
+        if let Err(err) = std::process::Command::new("xdg-open").arg(target).spawn() {
+            tracing::error!(?err, "nie mogę uruchomić xdg-open");
+        }
+    }
+}
+
+fn percent_encode(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for byte in s.bytes() {
+        match byte {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => {
+                out.push(byte as char)
+            }
+            _ => out.push_str(&format!("%{byte:02X}")),
+        }
+    }
+    out
+}
