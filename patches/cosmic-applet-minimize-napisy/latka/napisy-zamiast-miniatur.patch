+// patch: maksymalna dlugosc napisu w panelu (dluzsze nazwy konczy wielokropek).
+const LABEL_MAX_CHARS: usize = 20;
+
+fn short_label(name: &str) -> String {
+    if name.chars().count() > LABEL_MAX_CHARS {
+        let mut s: String = name.chars().take(LABEL_MAX_CHARS - 1).collect();
+        s.push('…');
+        s
+    } else {
+        name.to_owned()
+    }
+}
+
+// Zgrubna szerokosc napisu w px (czcionka panelu ~8 px na znak).
+fn label_width(name: &str) -> u32 {
+    short_label(name).chars().count() as u32 * 8
+}
